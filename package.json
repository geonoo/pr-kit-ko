{
  "name": "pr-kit-ko",
  "displayName": "PR Kit — 한국어 PR/커밋 규칙",
  "description": "한국어 PR 템플릿, 커밋 메시지 규칙, 체크리스트를 워크스페이스에 바로 넣습니다.",
  "version": "0.1.1",
  "publisher": "geonoo",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Snippets",
    "Formatters"
  ],
  "keywords": [
    "PR",
    "pull request",
    "commit",
    "conventional commits",
    "한국어",
    "템플릿",
    "checklist"
  ],
  "activationEvents": [],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "prKit.insertPrTemplate",
        "title": "PR Kit: PR 템플릿 넣기"
      },
      {
        "command": "prKit.insertCommitTemplate",
        "title": "PR Kit: 커밋 메시지 템플릿 넣기"
      },
      {
        "command": "prKit.insertChecklist",
        "title": "PR Kit: 체크리스트 넣기"
      },
      {
        "command": "prKit.insertAgentPrompt",
        "title": "PR Kit: 에이전트 프롬프트 넣기"
      },
      {
        "command": "prKit.applyWorkspaceFiles",
        "title": "PR Kit: 워크스페이스에 규칙 파일 생성"
      },
      {
        "command": "prKit.showLicense",
        "title": "PR Kit: 라이선스 상태"
      }
    ],
    "configuration": {
      "title": "PR Kit",
      "properties": {
        "prKit.licenseKey": {
          "type": "string",
          "default": "",
          "description": "Pro 라이선스 키. Gumroad 영수증의 키 또는 데모 키 PRKIT-PRO-DEMO-2026."
        },
        "prKit.customTemplatesPath": {
          "type": "string",
          "default": ".pr-kit",
          "description": "Pro 전용. 워크스페이스 안 커스텀 템플릿 폴더 경로."
        }
      }
    }
  },
  "scripts": {
    "test": "node --test test.mjs",
    "package": "npx --yes @vscode/vsce package --no-dependencies"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/geonoo/pr-kit-ko"
  },
  "license": "MIT",
  "icon": "media/icon.png"
}
